{
  "name": "highlight-corner",
  "private": true,
  "scripts": {
    "build:js": "tsc -p tsconfig.browser.json && tsc -p tsconfig.worker.json",
    "check:js": "tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "pretest": "node tools/check_generated.mjs",
    "build:css": "tailwindcss -i css/tailwind.css -o css/utilities.css --minify",
    "test": "node --test tests/*.test.cjs && python3 -m unittest discover -s tests -p 'test_content_refresh.py'"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "jsdom": "30.1.2",
    "lucide-static": "1.52.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3"
  }
}
